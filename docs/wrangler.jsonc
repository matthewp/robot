{
  "name": "robot",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "regularhuman.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  // Lets Workers Builds run `wrangler preview` for pull request branches.
  "previews": {}
}
