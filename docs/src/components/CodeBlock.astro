---
import { Prism } from '@astrojs/prism';

interface Props {
  code: string;
  title?: string;
  lang?: string;
}

const { code, title, lang = 'js' } = Astro.props;
---
<div class="code">
  <div class="code-head">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {title && <span class="label">{title}</span>}
    <span class="label lang">{lang.toUpperCase()}</span>
  </div>
  <Prism lang={lang} code={code} />
</div>
