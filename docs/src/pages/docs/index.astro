---
import Docs from '../../layouts/Docs.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const basicExample = `import { createMachine, state, transition } from 'robot3';

const machine = createMachine({
  inactive: state(
    transition('toggle', 'active')
  ),
  active: state(
    transition('toggle', 'inactive')
  )
});

export default machine;`;

const integrationExample = `import { useMachine } from 'react-robot';
import machine from './machine.js';

function Toggle() {
  const [current, send] = useMachine(machine);

  return (
    <button onClick={() => send('toggle')}>
      State: {current.name}
    </button>
  );
}`;

const asyncExample = `import { createMachine, invoke, reduce, state, transition } from 'robot3';

const context = () => ({ users: [] });

async function loadUsers() {
  const res = await fetch('/api/users');
  return res.json();
}

const machine = createMachine({
  idle: state(
    transition('fetch', 'loading')
  ),
  loading: invoke(loadUsers,
    transition('done', 'loaded',
      reduce((ctx, ev) => ({ ...ctx, users: ev.data }))
    ),
    transition('error', 'idle')
  ),
  loaded: state()
}, context);`;

const headings = [
  { depth: 2, slug: 'install', text: 'Install' },
  { depth: 2, slug: 'your-first-machine', text: 'Your first machine' },
  { depth: 2, slug: 'use-it-in-a-component', text: 'Use it in a component' },
  { depth: 2, slug: 'async-work', text: 'Async work' },
  { depth: 2, slug: 'where-next', text: 'Where next' },
];
---
<Docs title="Introduction" slug="" headings={headings}>
  <p>
    Robot is a small library for building <strong>finite state machines</strong>.
    You describe every state your code can be in and the events that move it
    between them, using nothing but functions. Invalid states can't happen,
    because they were never described.
  </p>

  <h2 id="install">Install</h2>
  <p>Robot is published to npm as <code>robot3</code>. It has no dependencies.</p>
  <CodeBlock lang="bash" code="npm install robot3" />

  <h2 id="your-first-machine">Your first machine</h2>
  <p>
    A machine is an object of named states. Each state lists the transitions
    out of it: the event that triggers it, and where it goes.
  </p>
  <CodeBlock title="machine.js" code={basicExample} />

  <h2 id="use-it-in-a-component">Use it in a component</h2>
  <p>
    Robot doesn't render anything itself. Integrations for
    <a href="/docs/react-robot/">React</a>, <a href="/docs/preact-robot/">Preact</a>,
    <a href="/docs/svelte-robot-factory/">Svelte</a>, <a href="/docs/lit-robot/">Lit</a> and
    <a href="/docs/haunted-robot/">Haunted</a> connect a machine to your UI.
  </p>
  <CodeBlock title="Toggle.jsx" lang="jsx" code={integrationExample} />

  <h2 id="async-work">Async work</h2>
  <p>
    <a href="/docs/invoke/"><code>invoke</code></a> runs a promise-returning function when a
    state is entered and transitions on <code>done</code> or <code>error</code>.
    <a href="/docs/reduce/"><code>reduce</code></a> folds the result into the machine's context.
  </p>
  <CodeBlock title="users.js" code={asyncExample} />

  <h2 id="where-next">Where next</h2>
  <div class="grid-2">
    <a class="link-card" href="/docs/core-concepts/">
      <span class="label">01 / Concepts</span>
      <span class="title">Core concepts</span>
      <span class="desc">States, transitions, events, guards and actions, one at a time.</span>
    </a>
    <a class="link-card" href="/docs/createmachine/">
      <span class="label">04 / API</span>
      <span class="title">API reference</span>
      <span class="desc">Every export, with signatures and examples.</span>
    </a>
    <a class="link-card" href="/docs/composition/">
      <span class="label">03 / Guides</span>
      <span class="title">Composition</span>
      <span class="desc">Build machines out of small reusable functions.</span>
    </a>
    <a class="link-card" href="/docs/comparison-with-xstate/">
      <span class="label">03 / Guides</span>
      <span class="title">Robot vs. XState</span>
      <span class="desc">How the two libraries differ, and when to pick which.</span>
    </a>
  </div>
</Docs>
