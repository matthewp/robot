---
import Base from '../layouts/Base.astro';
---
<Base title="Not found · Robot">
  <main class="wrap" style="padding: 7rem 1.5rem 8rem; max-width: 40rem;">
    <p class="label"><span class="led amber"></span>&nbsp; Error 404</p>
    <h1 style="margin: 1rem 0; font-size: 2.5rem; font-weight: 600; letter-spacing: -0.02em;">State not found.</h1>
    <p style="color: var(--text-2); margin: 0 0 2rem;">
      No transition leads here. The page may have moved, or never existed.
    </p>
    <a class="btn primary" href="/docs/">Return to docs</a>
  </main>
</Base>
